[Unit]
Description=LumOS Voice Recognition
After=app.service
Requires=app.service

[Service]
Type=simple
User=weston

ExecStartPre=/bin/sh -c 'until [ -S /tmp/lumos.sock ]; do sleep 1; done'
ExecStart=/usr/bin/python3 /usr/share/lumos/voice.py

Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target